// Online C++ compiler to run C++ program online
#include <iostream>
using namespace std;
int main() {
    int t;
    cin>>t;
    string a;
    int sum1=0,sum2=0;
    while(t--){
        cin>>a;
      int sum1=0,sum2=0;
        for(int i=0;i<3;i++){
            sum1 +=a[i];
        }
        for(int i=3;i<a.size();i++){
            sum2 +=a[i];
        }
         if(sum1==sum2){
        cout<<"YES"<<endl;
    }else{
        cout<<"NO"<<endl;
    }
    }
   
 
    return 0;
}